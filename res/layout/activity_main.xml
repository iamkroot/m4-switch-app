<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M4 Switcher"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Sennheiser Multipoint Connection Manager"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />

        <!-- Control Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- MAC Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_mac_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target: 80:C3:BA:6A:00:EF"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:typeface="monospace" />

                <Button
                    android:id="@+id/btn_edit_mac"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_secondary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Change"
                    android:textColor="#BBBBBB"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Status Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Refresh Button -->
            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:text="⟳  Refresh Connections"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Last Updated -->
            <TextView
                android:id="@+id/text_last_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Last updated: Never"
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Section 1: Currently Connected -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_connected_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CURRENTLY CONNECTED (0/2)"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 slots max"
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_connected_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_no_connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:text="No devices currently connected"
                android:textColor="#777777"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 2: Cached Connections -->
        <TextView
            android:id="@+id/text_paired_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="CACHED CONNECTIONS"
            android:textColor="#2196F3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Click any device to connect. If 2 slots are full, another device will disconnect automatically."
            android:textColor="#888888"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/container_all_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_no_cached"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:text="No cached connections found. Tap 'Refresh Connections' to load."
                android:textColor="#777777"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 3: Intent Reference -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="CLI &amp; Automation"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broadcast: dev.kroot.m4switch.ACTION_SWITCH"
                android:textColor="#64B5F6"
                android:textSize="11sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Extras: --es connect &quot;&lt;name&gt;&quot; [--es disconnect &quot;&lt;name&gt;&quot;]"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CLI: ./m4-switch.sh [name]"
                android:textColor="#777777"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
